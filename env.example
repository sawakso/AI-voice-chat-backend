# ========== LLM 模型选择 ==========
# deepseek / openai / qwen / glm / ollama
LLM_PROVIDER=deepseek
LLM_API_KEY=在此填你的密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ========== GPT-SoVITS 后端 ==========
TTS_API_URL=http://127.0.0.1:9880

# ========== 模型和音频目录 ==========
GPT_WEIGHTS_DIR=D:/*****/GPT_weights_v2
SOVITS_WEIGHTS_DIR=D:/****/SoVITS_weights_v2
REF_AUDIO_DIR=D:/Adobe/GPT-SoVTIS-V2/推理参考文件

# ========== 后端端口 ==========
BACKEND_PORT=8000

# ========== AI 人设（可选） ==========
SYSTEM_PROMPT=你是一个友好的助手，回复简洁自然，不超过100字。